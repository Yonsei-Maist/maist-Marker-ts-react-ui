{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "lib": [
            "es6",
            "dom",
            "es2016",
            "es2017"
        ],
        "allowJs": false,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "jsx": "react",
        "typeRoots": [
            "node_modules/@types"
        ],
    },
    "include": ["./src/**/*"], // storybook에서 core도 타입체크하려면 추가
    "exclude": [
        "node_modules"
    ],
    "references": [
      { "path": "./core" },
      { "path": "./graph" }
    ]
}