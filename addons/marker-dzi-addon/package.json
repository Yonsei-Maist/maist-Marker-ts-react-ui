      },
      "ol": {
          "optional": true
      },
      "axios": {
          "optional": true
      }
  },
  "devDependencies": {
    "@babel/cli": "^7.24.7",
    "@babel/core": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
